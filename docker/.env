## Agent image
MG_AGENT_IMAGE=ghcr.io/absmach/agent:latest

## HTTP
MG_AGENT_HTTP_PORT=9999

## MQTT
## Note: For Magistrala cloud set variables as follows:
# MG_AGENT_MQTT_URL=ssl://messaging.magistrala.absmach.eu:8883
# MG_AGENT_MQTT_SKIP_TLS=false
## The default compose stack includes a local MQTT 5 broker.
## Override with tcp://host.docker.internal:1883 to use a host FluxMQ instance.
MG_AGENT_MQTT_URL=tcp://mqtt:1883
MG_AGENT_MQTT_SKIP_TLS=true
MG_AGENT_LOCAL_MQTT_PORT=1884

MG_AGENT_MQTT_MTLS=false

## Node-RED MQTT identity (used when Bootstrap is disabled)
MG_AGENT_CLIENT_ID=a264392a-34c1-4595-982e-eb0761e3c188
MG_AGENT_CLIENT_SECRET=cli1
MG_AGENT_DOMAIN_ID=95fc594c-ae91-46a2-929b-3bec0e333223
MG_AGENT_CHANNEL=a0f1f5a5-77ba-4110-9405-af5ababde184
MG_AGENT_CTRL_CHANNEL=a2be8ec1-c8f4-4dea-a713-84c70f5a7f8c

## Standalone UI gateway
MG_AGENT_GATEWAY_TOKEN=change-me-before-deployment
## Optional role-scoped tokens. When set, JSON maps tokens to roles.
# MG_AGENT_GATEWAY_AUTH_TOKENS={"viewer-token":["viewer"],"support-token":["viewer","support"],"admin-token":["*"]}
MG_AGENT_GATEWAY_MQTT_USERNAME=agent-gateway-local
MG_AGENT_GATEWAY_MQTT_PASSWORD=local-development-only
MG_AGENT_GATEWAY_AGENTS=[{"id":"edge-agent-1","name":"Edge Agent 1","domain_id":"95fc594c-ae91-46a2-929b-3bec0e333223","control_channel":"a2be8ec1-c8f4-4dea-a713-84c70f5a7f8c","data_channel":"a0f1f5a5-77ba-4110-9405-af5ababde184"}]

## Internal services
MG_AGENT_NODERED_URL=http://nodered:1880/

## Timers
MG_AGENT_HEARTBEAT_INTERVAL=10s
MG_AGENT_TERMINAL_SESSION_TIMEOUT=60s
MG_AGENT_REMOTE_ENABLED=true
MG_AGENT_REMOTE_STORE_PATH=/var/lib/agent/remote.db
MG_AGENT_REMOTE_SESSION_EXPIRY=24h
MG_AGENT_REMOTE_STREAM_LIFETIME=10m
MG_AGENT_REMOTE_STREAM_IDLE=60s
MG_AGENT_REMOTE_MAX_STREAM_BYTES=8388608
MG_AGENT_REMOTE_MAX_STREAM_RATE=100
MG_AGENT_REMOTE_MAX_REQUEST_BYTES=1048576
MG_AGENT_REMOTE_MAX_REQUESTS=16

## OTA
MG_AGENT_OTA_ENABLED=true
MG_AGENT_OTA_BINARY_PATH=/usr/local/bin/agent
MG_AGENT_OTA_DOWNLOAD_DIR=/tmp

## Gateway credentials (not read by the Go binary directly).
## The docker-compose entrypoint (scripts/entrypoint.sh) reads these env vars
## and writes them into /var/lib/agent/agent-config.json, which is the flat-file
## store the Go binary reads at startup via applyPersistedOverrides().
## Fill these in from the output of `bash scripts/setup-agent.sh`, which prints
## the freshly provisioned IDs. Mapping:
##   MG_AGENT_GATEWAY_ID     <- GATEWAY_ID
##   MG_AGENT_GATEWAY_SECRET <- GATEWAY_KEY
##   MG_AGENT_TENANT_ID      <- TENANT_ID
##   MG_AGENT_CHANNEL        <- DATA_CHAN_ID
##   MG_AGENT_CTRL_CHANNEL   <- CTRL_CHAN_ID
MG_AGENT_GATEWAY_ID=a264392a-34c1-4595-982e-eb0761e3c188
MG_AGENT_GATEWAY_SECRET=cli1
MG_AGENT_TENANT_ID=95fc594c-ae91-46a2-929b-3bec0e333223
MG_AGENT_CHANNEL=a0f1f5a5-77ba-4110-9405-af5ababde184
MG_AGENT_CTRL_CHANNEL=a2be8ec1-c8f4-4dea-a713-84c70f5a7f8c

## Bootstrap (disabled - no bootstrap service integrated with Atom)
MG_AGENT_BOOTSTRAP_EXTERNAL_ID=""
MG_AGENT_BOOTSTRAP_EXTERNAL_KEY=""
MG_AGENT_BOOTSTRAP_URL=http://bootstrap:9013/clients/bootstrap
MG_AGENT_BOOTSTRAP_RETRIES=5
MG_AGENT_BOOTSTRAP_RETRY_DELAY_SECONDS=10
MG_AGENT_BOOTSTRAP_SKIP_TLS=false

## Device Manager
MG_AGENT_DEVICE_DB_PATH=/var/lib/agent/devices.db

## Config Store
MG_AGENT_CONFIG_PATH=/var/lib/agent/agent-config.json

## Atom GraphQL API
MG_AGENT_ATOM_URL=http://host.docker.internal:8080/graphql

## Provisioning (admin JWT from /auth/login — NOT a PAT, PATs don't work for GraphQL currently).
## Obtain a fresh token at runtime; never commit a real token here.
MG_PAT="<admin-jwt-from-/auth/login>"
MG_AGENT_RULES_ENGINE_URL=""
