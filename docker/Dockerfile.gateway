FROM golang:1.26-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/agent-gateway ./cmd/gateway

FROM alpine:3.22
RUN apk add --no-cache ca-certificates && adduser -D -u 10001 gateway
COPY --from=builder /out/agent-gateway /usr/local/bin/agent-gateway
USER gateway
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/agent-gateway"]
